{
  "manifest_version": 3,
  "name": "Reading Learning Panel",
  "description": "Extract article sections and generate a study-oriented side panel with OpenAI-compatible models.",
  "version": "0.1.0",
  "action": {
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    },
    "default_title": "Open Learning Panel"
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "background": {
    "service_worker": "dist/assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "dist/options.html",
  "permissions": ["activeTab", "sidePanel", "scripting", "storage", "tabs"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "side_panel": {
    "default_path": "dist/sidepanel.html"
  }
}
